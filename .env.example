# ==============================================================================
# ACCERO PRINTPORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), configure these variables in the project settings.
#
# RULE: Never commit .env, .env.local, or actual secret keys to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
# [Optional] Local development server port (Default: 3000)
PORT=3000

# [Required] Node runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# [Required] Public canonical application base URL (No trailing slash)
# Used for SEO canonical tags, OpenGraph URLs, and sitemaps.
NEXT_PUBLIC_APP_URL=https://printportal.accero.app

# [Optional] Client application URL (Fallback for password reset links)
CLIENT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------
# [Required] MongoDB connection URI (Replica Set / MongoDB Atlas recommended for multi-document ACID transactions)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/accero_pp?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & CRYPTOGRAPHIC SECRETS (JOSE JWT)
# ------------------------------------------------------------------------------
# [Required] Primary cryptographic key for signing Jose JWT tokens.
# MUST be at least 32 characters long. Generate via: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# [Optional] Dedicated Access Token Secret (Falls back to JWT_SECRET if omitted)
ACCESS_TOKEN_SECRET=your_access_token_secret_at_least_32_characters_long

# [Optional] Access Token Expiry duration (Default: '3d' or 259200 seconds)
ACCESS_TOKEN_EXPIRY=3d

# [Optional] Dedicated Refresh Token Secret (Falls back to internal default if omitted)
REFRESH_TOKEN_SECRET=your_refresh_token_secret_at_least_32_characters_long

# [Optional] Refresh Token Expiry duration (Default: '30d' or 2592000 seconds)
REFRESH_TOKEN_EXPIRY=30d

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (PAYTM)
# ------------------------------------------------------------------------------
# Required for live operator wallet recharges via dynamic UPI and QR code.
# [Optional/Production Required] Primary Paytm Merchant ID
PAYTM_MID=YOUR_PAYTM_MERCHANT_ID

# [Optional/Production Required] Paytm Merchant Secret Key for SHA256 checksums
PAYTM_MERCHANT_KEY=YOUR_PAYTM_MERCHANT_KEY

# [Optional/Production Required] Primary Paytm UPI VPA address (e.g. paytm.handle@pty)
PAYTM_UPI=paytm.yourhandle@pty

# [Optional] Paytm Website parameter (Default: 'DEFAULT')
PAYTM_WEBSITE=DEFAULT

# [Optional] Paytm Integration Mode ('STANDARD' | 'CUSTOM', Default: 'STANDARD')
PAYTM_ENVIRONMENT=STANDARD

# [Optional] Secondary Paytm Merchant Credentials (for multi-account load balancing)
# PAYTM_MID2=YOUR_SECONDARY_MERCHANT_ID
# PAYTM_UPI2=paytm.secondaryhandle@pty

# ------------------------------------------------------------------------------
# 5. DISTRIBUTED RATE LIMITING (UPSTASH REDIS)
# ------------------------------------------------------------------------------
# Serverless REST Redis credentials for edge rate limiting and burst protection.
# If omitted, system safely falls back to MongoDB TTL + in-memory store.
# [Optional] Upstash Redis REST URL
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io

# [Optional] Upstash Redis REST Token
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# [Optional] Vercel KV aliases (Supported automatically if Upstash keys are omitted)
# KV_REST_API_URL=https://your-kv-url.vercel-storage.com
# KV_REST_API_TOKEN=your_kv_token_here

# ------------------------------------------------------------------------------
# 6. EXTERNAL IDENTITY VERIFICATION PROVIDERS
# ------------------------------------------------------------------------------
# Live API keys for document lookup cascade (NeoAPI, AxenAPI, FastNexora).
# If omitted or unconfigured, operators can still manually input document details.
# [Optional] NeoAPI Key (V1/V2 Voter & Citizen Lookups)
NEO_API_KEY=your_neo_api_key_here

# [Optional] AxenAPI Key (Secondary lookup provider)
AXEN_API_KEY=your_axen_api_key_here

# [Optional] FastNexora Key (Tertiary lookup provider)
FASTNEXORA_API_KEY=your_fastnexora_api_key_here

# ------------------------------------------------------------------------------
# 7. OUTBOUND STATIC IP PROXY (FIXIE)
# ------------------------------------------------------------------------------
# Required for external government/provider endpoints requiring static IP whitelisting.
# All outbound requests to NeoAPI, AxenAPI, etc. route through this egress proxy.
# Format: http://fixie:<password>@<subdomain>.usefixie.com:80
# [Optional/Production Recommended] Fixie Proxy URL
FIXIE_URL=http://fixie:your-token@your-subdomain.usefixie.com:80

# [Optional/Dev Only] Allow direct fetch in local dev if FIXIE_URL is unset
# ALLOW_FIXIE_BYPASS_DEV=true

# ------------------------------------------------------------------------------
# 8. MEDIA STORAGE PIPELINE (CLOUDINARY)
# ------------------------------------------------------------------------------
# Server-side authenticated Cloudinary credentials for permanent citizen photo/signature storage.
# [Optional] Cloudinary Cloud Name
CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# [Optional] Cloudinary API Key
CLOUDINARY_API_KEY=your_api_key_here

# [Optional] Cloudinary API Secret (NEVER expose to client code)
CLOUDINARY_API_SECRET=your_api_secret_here

# [Optional] Client-side Cloud Name for public delivery
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# [Optional] Unified Cloudinary URL (Alternative to individual keys above)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ------------------------------------------------------------------------------
# 9. TRANSACTIONAL EMAIL & SMTP (NODEMAILER)
# ------------------------------------------------------------------------------
# SMTP credentials for sending password reset emails and account notifications.
# If omitted, password reset URLs are logged to the development console.
# [Optional] SMTP Server Hostname (e.g. smtp.gmail.com)
MAIL_HOST=smtp.gmail.com

# [Optional] SMTP Port (587 for TLS, 465 for SSL)
MAIL_PORT=587

# [Optional] SMTP Secure flag ('true' for SSL on port 465, 'false' for STARTTLS)
MAIL_SECURE=false

# [Optional] SMTP Username / Sender Email
MAIL_USER=your_email@gmail.com

# [Optional] SMTP Password or App-Specific Password
MAIL_PASS=your_email_app_password

# ------------------------------------------------------------------------------
# 10. ANALYTICS & TELEMETRY
# ------------------------------------------------------------------------------
# [Optional] Google Tag Manager Container ID
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ------------------------------------------------------------------------------
# 11. DEVELOPMENT & SANDBOX CONTROLS (STRICTLY FORBIDDEN IN PRODUCTION)
# ------------------------------------------------------------------------------
# WARNING: These flags MUST NEVER be enabled in production environments!
# [Optional/Dev Only] Allows instant wallet top-up in the UI without real payment
ALLOW_SANDBOX_RECHARGE=false

# [Optional/Dev Only] Allows mock simulation provider to return synthetic test documents
ALLOW_MOCK_PROVIDERS=false

# [Optional/Dev Only] Enables verbose external HTTP request logging in terminal
ENABLE_NETWORK_AUDIT_LOGS=false
