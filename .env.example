# ==============================================================================
# ACCERO PRINTPORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), configure these variables in the project settings.

# ------------------------------------------------------------------------------
# 1. CORE & DATABASE (MANDATORY)
# ------------------------------------------------------------------------------
# MongoDB connection string (Replica Set / Atlas recommended for transactions)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/printportal?retryWrites=true&w=majority

# JWT Session Secret: MUST be at least 32 characters long.
# Generate a cryptographically secure key: openssl rand -base64 32
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security

# Node Environment
NODE_ENV=production

# Application Base URL
NEXT_PUBLIC_APP_URL=https://printportal.accero.app

# ------------------------------------------------------------------------------
# 2. PAYMENT GATEWAY - PAYTM (MANDATORY FOR LIVE RECHARGES)
# ------------------------------------------------------------------------------
# Paytm Merchant Credentials (No hardcoded fallbacks are used)
# Single merchant or Primary merchant:
PAYTM_MID=YOUR_PAYTM_MERCHANT_ID
PAYTM_MERCHANT_KEY=YOUR_PAYTM_MERCHANT_KEY
PAYTM_UPI=paytm.yourhandle@pty

# Multi-merchant JSON configuration (Optional: for load-balancing / multiple accounts)
# Format: [{"id":"acc1","label":"Main","mid":"...","key":"...","upi":"...","active":true}]
# PAYTM_ACCOUNTS=[{"id":"acc1","label":"Main","mid":"...","key":"...","upi":"...","active":true}]

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED RATE LIMITING (HIGHLY RECOMMENDED FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Upstash Redis REST credentials for distributed edge rate limiting.
# If omitted, system falls back to MongoDB TTL + in-memory store.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ------------------------------------------------------------------------------
# 4. EXTERNAL IDENTITY VERIFICATION PROVIDERS
# ------------------------------------------------------------------------------
# Live API Keys for document lookup cascade (NeoAPI, Axen, FastNexora)
NEO_API_KEY=your_neo_api_key_here
AXEN_API_KEY=your_axen_api_key_here
FASTNEXORA_API_KEY=your_fastnexora_api_key_here

# ------------------------------------------------------------------------------
# 5. FIXED IP OUTBOUND PROXY (FIXIE)
# ------------------------------------------------------------------------------
# Static outbound IP proxy for third-party API whitelisting (Vercel / Heroku).
# Docs: https://usefixie.com/documentation/http-and-https-requests
# When configured, all external verification and payment status requests route
# through Fixie's static IP addresses. When omitted, direct fetch is used.
# Format: http://fixie:<password>@<subdomain>.usefixie.com:80 (or port 443 for TLS)
FIXIE_URL=http://fixie:your-token@your-subdomain.usefixie.com:80

# ------------------------------------------------------------------------------
# 6. SECURITY & SANDBOX CONTROLS (DEV / STAGING ONLY)
# ------------------------------------------------------------------------------
# CRITICAL: Do NOT enable these in production environments!
# Allows instant wallet credit without payment gateway or admin approval
ALLOW_SANDBOX_RECHARGE=false

# Allows MockSimulation provider to return synthetic test documents
ALLOW_MOCK_PROVIDERS=false

# ------------------------------------------------------------------------------
# 7. ANALYTICS & GOOGLE TAG MANAGER
# ------------------------------------------------------------------------------
# Google Tag Manager Container ID
NEXT_PUBLIC_GTM_ID=GTM-MKXHQ658
